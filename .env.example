# ==========================================
# Coding Shaft Lead Intelligence Engine
# Environment Configuration
# ==========================================

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info

# Database (PostgreSQL / Supabase)
# Transaction pooler or direct connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coding_shaft_leads?schema=public"
# Direct URL for migrations (if using connection pooler like PgBouncer)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/coding_shaft_leads?schema=public"

# AI Provider (Google Gemini API)
GEMINI_API_KEY="your-gemini-api-key-here"

# Business Discovery (Google Places API / Other Supported Provider)
GOOGLE_PLACES_API_KEY="your-google-places-api-key-here"

# Google Sheets Export / Sync Integration
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID="your-spreadsheet-id-here"

# Rate Limiting & Safety
MAX_SEARCH_RESULTS_DEFAULT=20
DISCOVERY_RATE_LIMIT_PER_MINUTE=60
RESEARCH_REQUEST_TIMEOUT_MS=15000
